{
  "App": {
    "SelfUrl": "https://localhost:44364",
    "DisablePII": false,
    "HealthCheckUrl": "/health-status"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=LuckyLotApi;User ID=ydls;Password=REPLACE_ME_IN_APPSETTINGS_SECRETS_JSON;"
  },
  "AuthServer": {
    "Authority": "https://localhost:44364",
    "RequireHttpsMetadata": true,
    "SwaggerClientId": "LuckyLotApi_Swagger",
    "CertificatePassPhrase": "REPLACE_ME_IN_APPSETTINGS_SECRETS_JSON"
  },
  "StringEncryption": {
    "DefaultPassPhrase": "REPLACE_ME_IN_APPSETTINGS_SECRETS_JSON"
  }
}